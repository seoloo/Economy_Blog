{#- mode: "tistory" = 티스토리 HTML 모드에 붙여넣을 본문, "preview" = 메일/로컬 확인용
    흐름: 대표 이미지 → 도입 → 오늘 시장 한눈에 → 1.해외(표) → 2.국내(표) → 3.체크포인트 → 4.차트 → 5.이슈 → 6.일정 → 마무리
    스타일은 티스토리·메일 어디서나 유지되도록 인라인으로만 쓰고, 칸 배치는 표(table)로 한다. -#}
{%- set ACCENT = "#13294b" -%}
{%- set SOFT = "#f4f6fa" -%}
{%- set LINE = "#e3e7ee" -%}
{%- set MUTED = "#7d8593" -%}
{%- set ns = namespace(n=0) -%}

{%- macro h2(title) -%}
{%- set ns.n = ns.n + 1 -%}
<h2 style="margin:44px 0 16px;padding:0 0 10px;border-bottom:2px solid {{ ACCENT }};font-size:21px;line-height:1.4;color:{{ ACCENT }};">{{ ns.n }}. {{ title }}</h2>
{%- endmacro -%}

{%- macro chart_block(chart, caption=True) -%}
<figure style="margin:24px 0;text-align:center;">
{%- if chart.url %}
  <img src="{{ chart.url }}" alt="{{ chart.alt_text }}" style="max-width:100%;height:auto;border-radius:8px;">
{%- elif mode == "preview" %}
  <img src="charts/{{ chart.path.name }}" alt="{{ chart.alt_text }}" style="max-width:100%;height:auto;border-radius:8px;">
{%- else %}
  <div style="padding:28px 12px;border:2px dashed #c3c2b7;color:#52514e;font-size:14px;">
    [이미지 삽입] {{ chart.path.name }} — 이 상자를 지우고 차트 이미지를 올리세요.<br>
    대체 텍스트: {{ chart.alt_text }}
  </div>
{%- endif %}
{%- if caption %}
  <figcaption style="font-size:13px;color:{{ MUTED }};margin-top:6px;">{{ chart.title }} · {{ chart.source_note }}</figcaption>
{%- endif %}
</figure>
{%- endmacro -%}

{%- macro quote_table(table) -%}
{%- if table.rows %}
<table style="width:100%;border-collapse:collapse;font-size:14px;margin:16px 0 4px;border:1px solid {{ LINE }};">
  <thead>
    <tr style="background:{{ SOFT }};">
      <th style="text-align:left;padding:9px 8px;border-bottom:1px solid {{ LINE }};color:{{ ACCENT }};">지표</th>
      <th style="text-align:right;padding:9px 8px;border-bottom:1px solid {{ LINE }};color:{{ ACCENT }};">수치</th>
      <th style="text-align:right;padding:9px 8px;border-bottom:1px solid {{ LINE }};color:{{ ACCENT }};">전일 대비</th>
      <th style="text-align:right;padding:9px 8px;border-bottom:1px solid {{ LINE }};color:{{ ACCENT }};">등락률</th>
    </tr>
  </thead>
  <tbody>
{% for r in table.rows %}
    <tr>
      <td style="padding:9px 8px;border-bottom:1px solid {{ LINE }};">{{ r.label }}</td>
      <td style="text-align:right;padding:9px 8px;border-bottom:1px solid {{ LINE }};font-weight:bold;">{{ r.value }}</td>
      <td style="text-align:right;padding:9px 8px;border-bottom:1px solid {{ LINE }};color:{{ r.color }};">{{ r.change }}</td>
      <td style="text-align:right;padding:9px 8px;border-bottom:1px solid {{ LINE }};color:{{ r.color }};">{{ r.change_pct }}</td>
    </tr>
{% endfor %}
  </tbody>
</table>
<p style="margin:0 0 20px;font-size:12px;color:{{ MUTED }};">{{ table.note }}</p>
{%- endif %}
{%- endmacro -%}

{%- macro paragraphs(items) -%}
{% for p in items %}<p style="margin:0 0 14px;line-height:1.8;">{{ p | rich }}</p>
{% endfor %}
{%- endmacro -%}

{%- if mode == "preview" %}<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ c.title | plain }}</title></head>
<body style="max-width:760px;margin:0 auto;padding:16px;font-family:'Malgun Gothic','Apple SD Gothic Neo',sans-serif;font-size:16px;line-height:1.8;color:#1b1f27;background:#ffffff;">
<div style="background:#fffaf0;border:1px solid #f0e2c0;border-radius:8px;padding:14px 18px;margin-bottom:28px;font-size:14px;">
  <strong>발행 전 확인</strong>
  <ol style="margin:8px 0 0 18px;padding:0;">
    <li>제목: {{ c.title | plain }}</li>
    <li>태그: {{ c.tags | join(", ") }}</li>
    <li>티스토리 편집기를 HTML 모드로 바꾸고 첨부한 post.html 내용을 통째로 붙여넣기</li>
{%- if draft.charts | rejectattr("url") | list %}
    <li>[이미지 삽입] 상자 자리에 첨부한 차트 PNG 올리기</li>
{%- endif %}
    <li>대표 이미지를 맨 위 그림으로 지정하기</li>
    <li>[함께 보면 좋은 글] 상자에 지난 글 링크 넣기 (없으면 상자 삭제)</li>
    <li>수치와 사실을 다시 확인하고, 내 의견 한두 문장 덧붙이기</li>
  </ol>
  {%- if draft.warnings %}
  <p style="margin:12px 0 0;color:#d03b3b;"><strong>⚠ 검토 필요 {{ draft.warnings | length }}건</strong></p>
  <ul style="margin:4px 0 0 18px;padding:0;color:#d03b3b;">
    {%- for w in draft.warnings %}<li>{{ w }}</li>{% endfor %}
  </ul>
  {%- endif %}
</div>
<h1 style="font-size:26px;line-height:1.4;">{{ c.title | plain }}</h1>
{%- endif %}

{% if cover %}{{ chart_block(cover, caption=False) }}{% endif %}

<p style="margin:0 0 14px;line-height:1.8;">{{ c.lead | rich }}</p>

{#- 오늘 시장 한눈에: 요약 한 줄 + 지표 카드 2열 -#}
<div style="margin:24px 0 8px;padding:18px 18px 10px;background:{{ SOFT }};border-left:4px solid {{ ACCENT }};border-radius:6px;">
  <p style="margin:0 0 4px;font-size:13px;font-weight:bold;color:{{ ACCENT }};">오늘 시장 한눈에</p>
  <p style="margin:0 0 12px;font-size:17px;font-weight:bold;line-height:1.6;">{{ c.summary_line | plain }}</p>
{%- if glance.rows %}
  <table style="width:100%;table-layout:fixed;border-collapse:separate;border-spacing:0 8px;">
{% for pair in glance.rows | batch(2) %}
    <tr>
{% for r in pair %}
      <td style="width:50%;padding:0 {{ '4px 0 0' if loop.first else '0 0 4px' }};border:none;vertical-align:top;">
        <div style="padding:10px 12px;background:#ffffff;border:1px solid {{ LINE }};border-radius:8px;">
          <div style="font-size:12px;color:{{ MUTED }};">{{ r.label }}</div>
          <div style="font-size:17px;font-weight:bold;">{{ r.value }}</div>
          <div style="font-size:13px;color:{{ r.color }};">{{ r.headline }}</div>
        </div>
      </td>
{% endfor %}
{% if pair | length < 2 %}      <td style="width:50%;border:none;"></td>
{% endif %}
    </tr>
{% endfor %}
  </table>
  <p style="margin:0 0 6px;font-size:12px;color:{{ MUTED }};">{{ glance.note }}</p>
{%- endif %}
</div>
{% for chart in lead_charts %}{{ chart_block(chart) }}
{% endfor %}

{{ h2("해외 시장") }}
{{ quote_table(global_table) }}
{{ paragraphs(c.global_market) }}

{{ h2("국내 시장") }}
{{ quote_table(korea_table) }}
{{ paragraphs(c.korea_market) }}
{%- if c.korea_checkpoints %}

{{ h2("한국 증시 체크포인트") }}
<table style="width:100%;border-collapse:collapse;margin:8px 0 16px;">
{% for k in c.korea_checkpoints %}
  <tr>
    <td style="width:34px;padding:10px 0;border:none;border-bottom:1px solid {{ LINE }};vertical-align:top;">
      <span style="display:inline-block;width:24px;height:24px;border-radius:12px;background:{{ ACCENT }};color:#ffffff;text-align:center;font-size:13px;line-height:24px;font-weight:bold;">{{ loop.index }}</span>
    </td>
    <td style="padding:10px 0;border:none;border-bottom:1px solid {{ LINE }};line-height:1.7;">{{ k | rich }}</td>
  </tr>
{% endfor %}
</table>
{%- endif %}
{%- if body_charts %}

{{ h2("차트로 보는 주요 지표") }}
{% for chart in body_charts %}{{ chart_block(chart) }}
{% endfor %}
{%- endif %}

{{ h2("오늘의 주요 이슈") }}
{% for issue in c.issues %}
<h3 style="margin:30px 0 12px;font-size:18px;line-height:1.5;">
  <span style="display:inline-block;margin-right:6px;padding:2px 8px;border-radius:4px;background:{{ ACCENT }};color:#ffffff;font-size:12px;vertical-align:middle;">이슈 {{ loop.index }}</span>{{ issue.title | plain }}
</h3>
{{ paragraphs(issue.paragraphs) }}
{%- if issue.reference_urls %}
<p style="margin:0 0 8px;font-size:13px;color:{{ MUTED }};">참고:
{%- for url in issue.reference_urls %} <a href="{{ url }}" target="_blank" rel="noopener nofollow" style="color:{{ MUTED }};">{{ ref_names.get(url, "원문") }}</a>{% if not loop.last %},{% endif %}{% endfor %}</p>
{%- endif %}
{% endfor %}

{%- if c.watch_points %}
{{ h2("앞으로 확인할 일정·지표") }}
<ul style="margin:8px 0 16px;padding-left:20px;line-height:1.8;">
{% for w in c.watch_points %}  <li style="margin-bottom:6px;">{{ w | rich }}</li>
{% endfor %}</ul>
{%- endif %}

<div style="margin:40px 0 24px;padding:18px;border:1px solid {{ LINE }};border-radius:8px;">
  <p style="margin:0 0 6px;font-size:13px;font-weight:bold;color:{{ ACCENT }};">마무리</p>
  <p style="margin:0;line-height:1.8;">{{ c.closing | rich }}</p>
</div>

{%- if references %}
<p style="margin:28px 0 6px;font-size:14px;font-weight:bold;">참고 자료</p>
<ul style="margin:0 0 16px;padding-left:20px;font-size:13px;color:{{ MUTED }};">
{% for r in references %}  <li><a href="{{ r.url }}" target="_blank" rel="noopener nofollow" style="color:{{ MUTED }};">{{ r.title }}</a> · {{ r.source_name }}</li>
{% endfor %}</ul>
{%- endif %}

<div style="margin:24px 0;padding:16px 12px;border:2px dashed #c3c2b7;color:#52514e;font-size:14px;">
  [함께 보면 좋은 글] 지난 시황 글 링크 2~3개를 넣거나, 넣을 글이 없으면 이 상자를 지우세요.
</div>

<p style="margin-top:28px;padding:12px 14px;background:{{ SOFT }};border-radius:6px;font-size:12px;line-height:1.7;color:{{ MUTED }};">
이 글은 공개된 뉴스와 시장 데이터를 바탕으로 작성한 개인적인 정리이며, 특정 종목이나 자산의 매수·매도를 권유하지 않습니다. 투자 판단과 그 결과의 책임은 투자자 본인에게 있습니다. 차트와 표는 공개 데이터로 직접 작성했습니다.
</p>
{%- if hashtags %}
<p style="font-size:14px;color:{{ MUTED }};">{{ hashtags }}</p>
{%- endif %}
{%- if mode == "preview" %}
</body></html>
{%- endif %}
