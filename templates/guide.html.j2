{#- 경제 공부 글. mode: "tistory" = 티스토리 HTML 모드에 붙여넣을 본문, "preview" = 메일/로컬 확인용, "naver" = 네이버 블로그 붙여넣기용
    흐름: 인사 도입 → 제목 큰 소제목 + 대표 이미지 → 질문형 소제목(문단 + 간단한 표) → 첫 소제목 뒤 지금 수치(표·차트)
          → 흔히 하는 오해 → 마치며 → 면책 문구 → 최근에 올라온 글 → 키워드 줄
    공통 부품(간격·라벨·표·상자)과 티스토리에서 남는 스타일 규칙은 _tistory.html.j2 에 있다. -#}
{%- from "_tistory.html.j2" import ACCENT, SOFT, MUTED, sty, gap, p, h2, h3, chart_block, simple_table, paragraphs, preview_open, naver_open, wrap_up, footer with context -%}

{%- macro now_table(rows) -%}
{%- set td = "border:1px solid #dddddd;padding:8px;" %}
<table border="1" data-ke-align="alignLeft" style="border-collapse:collapse;width:100%;{{ 'font-size:15px;' if mode == 'preview' }}">
  <tbody>
    <tr>
      <td{{ sty("background-color:" ~ SOFT ~ ";color:" ~ ACCENT ~ ";", td) }}><b>지표</b></td>
      <td{{ sty("background-color:" ~ SOFT ~ ";color:" ~ ACCENT ~ ";text-align:right;", td) }}><b>지금</b></td>
      <td{{ sty("background-color:" ~ SOFT ~ ";color:" ~ ACCENT ~ ";text-align:right;", td) }}><b>1년 전</b></td>
      <td{{ sty("background-color:" ~ SOFT ~ ";color:" ~ ACCENT ~ ";text-align:right;", td) }}><b>최근 5년 범위</b></td>
    </tr>
{% for r in rows %}
    <tr>
      <td{{ sty("", td) }}>{{ r.label }}</td>
      <td{{ sty("text-align:right;", td) }}><b>{{ r.value }}</b></td>
      <td{{ sty("text-align:right;", td) }}>{{ r.year_ago }}</td>
      <td{{ sty("text-align:right;", td) }}>{{ r.range }}</td>
    </tr>
{% endfor %}
  </tbody>
</table>
{{ p("기준일 " ~ (rows | map(attribute="as_of") | max) ~ " · " ~ source_note, "size14", "color:" ~ MUTED ~ ";", "font-size:13px;margin-top:4px;") }}
{{ gap() }}
{%- endmacro -%}

{%- if mode == "preview" %}{{ preview_open(c, draft, ["카테고리를 '경제 공부'로 지정하기", "대표 이미지를 맨 위 그림으로 지정하기", "설명이 정확한지 다시 확인하고, 내 경험이나 의견 한두 문장 덧붙이기"]) }}{% elif mode == "naver" %}{{ naver_open(c) }}{% endif %}

{{ paragraphs(c.lead) }}
{{ h2(c.title | plain, num=False) }}
{% if cover %}{{ chart_block(cover, caption=False) }}
{{ gap() }}{% endif %}

{%- for sec in c.sections %}
{{ h3(sec.heading | plain) }}
{{ paragraphs(sec.paragraphs) }}
{%- if sec.table and sec.table.rows %}
{{ gap() }}
{{ simple_table(sec.table.columns, sec.table.rows) }}
{%- endif %}
{%- if loop.first and (now_rows or body_charts) %}

{{ h3("지금 수치로 보면?") }}
{%- if now_rows %}
{{ now_table(now_rows) }}
{%- endif %}
{% for chart in body_charts %}{{ chart_block(chart) }}
{{ gap() }}
{% endfor %}
{{ p(c.now_comment | rich) }}
{%- endif %}
{%- endfor %}
{%- if not (now_rows or body_charts) %}
{{ gap() }}
{{ p(c.now_comment | rich) }}
{%- endif %}
{%- if c.myths %}

{{ h3("흔히 하는 오해") }}
{% for m in c.myths %}{% if not loop.first %}{{ gap() }}{% endif %}
{{ p(("<b>" | safe) ~ "①②③④⑤⑥"[loop.index0] ~ " " ~ (m.myth | plain) ~ ("</b>" | safe), "size16", "color:" ~ ACCENT ~ ";") }}
{{ p(("→ " | safe) ~ (m.fact | rich)) }}
{% endfor %}
{%- endif %}

{{ wrap_up(c.closing, "h3") }}
{{ footer(c.keywords or c.tags, recent, "관련된 경제 공부 글이나 최근 시황 글 링크 2~3개를 넣거나, 넣을 글이 없으면 이 줄을 지우세요.") }}
