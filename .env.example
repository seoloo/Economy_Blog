# 로컬 실행용. 복사해서 .env로 만들고 값을 채운다. GitHub Actions에서는 같은 이름으로 Secrets에 등록한다.

# 글 작성 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 기사 분류·중복 제거 (https://console.laya-ai.com)
LAYA_API_KEY=

# 미국 금리 등 (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# 한국 금리·환율 등 (https://ecos.bok.or.kr/api/)
ECOS_API_KEY=

# 초안 메일 발송 (Gmail은 2단계 인증 후 앱 비밀번호 사용)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# 차트 PNG를 공개 이미지 레포에 올리기 (fine-grained 토큰, 대상 레포 Contents 쓰기 권한만)
CHARTS_REPO_TOKEN=

# 인스타 카드 배경 사진 (https://pixabay.com/api/docs/ 로그인하면 키가 보임)
PIXABAY_API_KEY=

# 인스타 자동 게시 (settings.yaml instagram.publish: true 일 때만 사용). 계정마다 토큰과 숫자 계정 ID.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_EN_ACCESS_TOKEN=
INSTAGRAM_EN_USER_ID=
